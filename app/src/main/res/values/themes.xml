<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoPlayAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">#0B0E1A</item>
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="BodyDim">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
